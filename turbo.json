{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**"],
      "env": [
        "APP_BASE_URL",
        "BROWSER_WS_ENDPOINT",
        "CRON_KEY",
        "CRON_SECRET",
        "CRON_URL",
        "EMAIL_FROM",
        "ENAIBLE_EMAIL_API_KEY",
        "ENAIBLE_EMAIL_SERVICE_URL",
        "EMAIL_SERVER_HOST",
        "EMAIL_SERVER_PASSWORD",
        "EMAIL_SERVER_PORT",
        "EMAIL_SERVER_USER",
        "ENCRYPTION_KEY",
        "ENAIBLE_SESSION_SECRET",
        "FIREBASE_CLIENT_EMAIL",
        "FIREBASE_PRIVATE_KEY",
        "FIREBASE_PROJECT_ID",
        "GEMINI_API_KEY",
        "GCLOUD_PROJECT",
        "GOOGLE_CLIENT_EMAIL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GOOGLE_CLOUD_PROJECT",
        "GOOGLE_PRIVATE_KEY",
        "GOOGLE_PROJECT_ID",
        "HDIDIDO_EMAIL",
        "HDIDIDO_PASSWORD",
        "HDIDIDO_TEE_BASE",
        "HDIDIDO_TEE_COURSE_ID",
        "HDIDIDO_TEE_TOKEN",
        "IRON_ACRE_MEMBER_CODE",
        "NEXTAUTH_SECRET",
        "NEXTAUTH_URL",
        "PHOTO_UPLOAD_ENDPOINT",
        "PHOTO_UPLOAD_SECRET",
        "SHEETS_SPREADSHEET_ID",
        "SITEBUILDER_BASE_HOST",
        "SITEBUILDER_BASE_HOSTS",
        "SITEBUILDER_HOSTS_JSON",
        "SITEBUILDER_STRIPE_ACCOUNT_COUNTRY",
        "STRIPE_PRICE_ID_MONTHLY_20",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "TRAINER_EMAIL",
        "TRAINER_PHONE",
        "VAPID_PRIVATE_KEY"
      ]
    },
    "dev": {
      "cache": false
    },
    "start": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
