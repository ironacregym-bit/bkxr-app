# Set to the real production domain for canonical, social, and sitemap links.
NEXT_PUBLIC_SITE_URL=

# SMTP credentials. Use the same values as the Iron Acre app's email setup.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=

# Optional. Defaults to EMAIL_SERVER_USER when unset.
IRON_ACRE_NOTIFY_EMAIL=

# Optional URL for the free 7-day training plan.
IRON_ACRE_PROGRAM_URL=
