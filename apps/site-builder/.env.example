# Override only when using a custom domain; the Vercel project URL is the default.
# Do not set NEXTAUTH_URL to the Iron Acre Gym origin.
NEXTAUTH_URL=https://site-builder-two-pi.vercel.app
SITEBUILDER_URL=https://site-builder-two-pi.vercel.app

# Generate a unique value for SiteBuilder; do not reuse Iron Acre's secret.
SITEBUILDER_NEXTAUTH_SECRET=

# Google OAuth callback must include:
# https://sitebuilder.example.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Firebase service account used by SiteBuilder's Firestore APIs and auth adapter.
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Optional email magic-link provider.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=
