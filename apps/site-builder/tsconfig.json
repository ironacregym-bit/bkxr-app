{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "types": ["node", "react", "react-dom"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@pt/firebase": ["../../packages/firebase/src"],
      "@pt/agents": ["../../packages/agents/src"],
      "@pt/tools": ["../../packages/AgentTools/src"],
      "@pt/types": ["../../packages/types/src"],
      "@root/*": ["../../*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "../iron-acre-app/types/next-auth.d.ts"
  ],
  "exclude": ["node_modules"]
}
