# Public EnAIble origin; used to construct NextAuth callback URLs.
ENAIBLE_URL=http://localhost:3003

# Google OAuth web client for EnAIble sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GCP project and service account used for the shared Firestore database.
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Separate random secrets for NextAuth sessions and active-organisation cookies.
ENAIBLE_NEXTAUTH_SECRET=
ENAIBLE_SESSION_SECRET=

# Server-side SMTP sender used by the shared email service.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=

# MCP/email API credentials are created per organisation in Email & MCP settings.
# Never expose these values to client-side code.
