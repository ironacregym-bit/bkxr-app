# Firebase web app settings (public identifiers, not secrets). Google sign-in
# uses the Firebase Auth provider; it needs no additional app OAuth secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin service account credentials.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Long random value used to sign active-organisation session cookies.
ENAIBLE_SESSION_SECRET=

# Server-side SMTP sender used by the shared email service.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=

# MCP/email API credentials are created per organisation in Email & MCP settings.
# Never expose these values to client-side code.
